---
// The page shell: <head>, fonts, the themed `.stage` wrapper, and the global
// cursor/scroll effects. Page content is dropped into the <slot/> inside `.wrap`.
import "../styles/global.css";
import "../styles/limelight.css";

interface Props {
  title?: string;
}
const { title = "Daniel Curry" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,200..600&family=Instrument+Serif:ital@0;1&family=Geist:wght@100..900&family=Geist+Mono:wght@300..600&display=swap"
      rel="stylesheet"
    />
    <!-- Set the page background from the saved theme before first paint, so dark
         users never see a flash of the light background. The .stage's data-theme
         is set by the matching script at the end of <body> (the element doesn't
         exist yet here). Both mirror getStoredTheme() in scripts/theme.ts. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("dc-theme");
          if (t !== "dark" && t !== "light") t = "light";
          document.documentElement.style.background =
            t === "dark" ? "oklch(0.18 0.008 80)" : "oklch(0.975 0.006 85)";
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="stage dir-limelight" id="stage" data-theme="light">
      <div class="glow"></div>
      <div class="wrap">
        <slot />
      </div>
    </div>

    <!-- Apply data-theme to the stage before paint to match the head script. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("dc-theme");
          if (t !== "dark" && t !== "light") t = "light";
          var stage = document.getElementById("stage");
          if (stage) stage.setAttribute("data-theme", t);
          var bg = t === "dark" ? "oklch(0.18 0.008 80)" : "oklch(0.975 0.006 85)";
          document.body.style.backgroundColor = bg;
        } catch (e) {}
      })();
    </script>

    <script>
      // Wire up the document-wide effects once the DOM is ready. These touch the
      // whole page (window events, the headline, the glow) rather than any single
      // component, so they live as plain modules rather than React islands.
      import { initLimelight } from "../scripts/limelight";
      import { initReveal } from "../scripts/reveal";

      const stage = document.getElementById("stage");
      if (stage) {
        initReveal(stage);
        initLimelight(stage);
      }
    </script>
  </body>
</html>
